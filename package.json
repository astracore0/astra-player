  "description": "Self-hosted anime/video player for your own files: Node + ffmpeg server, phone-friendly web UI, live 10-bit/HEVC conversion with a disk cache",
  "main": "server.js",
  "scripts": {
    "start": "node server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
